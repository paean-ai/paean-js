{
  "schemaVersion": 1,
  "package": "@paean-ai/paean-js",
  "version": "0.2.0",
  "upstream": {
    "package": "three",
    "version": "0.186.0",
    "reference": "paean/upstream.json",
    "exports": "All upstream core exports are re-exported with original identity."
  },
  "conventions": {
    "time": "seconds",
    "rotation": "radians",
    "worldYAxis": "up",
    "atlasOrigin": "top-left",
    "tileDataOrder": "row-major-top-down",
    "pixelWorldUnits": 1
  },
  "entryPoints": [
    ".",
    "./game",
    "./webgpu",
    "./tsl",
    "./vector-svg",
    "./addons",
    "./addons/*",
    "./examples/jsm/*",
    "./examples/fonts/*",
    "./src/*",
    "./schemas/*",
    "./package.json",
    "./core",
    "./2d",
    "./vector",
    "./pixel",
    "./platform",
    "./formats",
    "./3d",
    "./3d/vector",
    "./3d/pixel",
    "./bundles/*"
  ],
  "gameExports": [
    {
      "name": "Game2D",
      "kind": "class",
      "methods": [
        "start",
        "stop",
        "dispose"
      ],
      "example": "packages/paean-js/examples/pixel.js"
    },
    {
      "name": "FixedStepLoop",
      "kind": "class",
      "methods": [
        "advance",
        "start",
        "stop",
        "dispose"
      ],
      "units": "seconds"
    },
    {
      "name": "Input",
      "kind": "class",
      "methods": [
        "down",
        "justPressed",
        "justReleased",
        "axis",
        "setAction",
        "endFrame",
        "reset",
        "dispose"
      ]
    },
    {
      "name": "AssetStore",
      "kind": "class",
      "methods": [
        "load",
        "has",
        "dispose"
      ]
    },
    {
      "name": "Random",
      "kind": "class",
      "methods": [
        "next",
        "range",
        "int",
        "pick"
      ],
      "properties": [
        "state"
      ]
    },
    {
      "name": "VectorShape",
      "kind": "class",
      "extends": "three.Mesh",
      "staticMethods": [
        "rectangle",
        "circle",
        "polygon"
      ],
      "methods": [
        "dispose"
      ]
    },
    {
      "name": "Skeleton2D",
      "kind": "class",
      "extends": "three.Group",
      "methods": [
        "addSlot",
        "defineSkin",
        "setSkin",
        "createClip",
        "play",
        "update",
        "dispose"
      ],
      "example": "packages/paean-js/examples/skeleton.js"
    },
    {
      "name": "PixelAtlas",
      "kind": "class",
      "staticMethods": [
        "grid"
      ],
      "methods": [
        "frame",
        "uv",
        "dispose"
      ]
    },
    {
      "name": "PixelSprite",
      "kind": "class",
      "extends": "three.Mesh",
      "methods": [
        "setFrame",
        "setFlip",
        "dispose"
      ]
    },
    {
      "name": "SpriteAnimator",
      "kind": "class",
      "methods": [
        "define",
        "play",
        "stop",
        "update"
      ]
    },
    {
      "name": "PixelViewport",
      "kind": "class",
      "methods": [
        "resize",
        "screenToWorld",
        "snap"
      ]
    },
    {
      "name": "TileMap",
      "kind": "class",
      "extends": "three.Mesh",
      "methods": [
        "getTile",
        "setTile",
        "setTiles",
        "pointToTile",
        "isSolid",
        "toJSONDefinition",
        "dispose"
      ]
    },
    {
      "name": "GridCollision",
      "kind": "class",
      "methods": [
        "overlaps",
        "move"
      ]
    },
    {
      "name": "importAseprite",
      "kind": "function",
      "returns": "{ atlas: PixelAtlas, clips: Record<string, SpriteClip> }"
    },
    {
      "name": "importTiledLayer",
      "kind": "function",
      "returns": "TileMapDefinition"
    },
    {
      "name": "PaeanPlatform",
      "kind": "class",
      "methods": [
        "connect",
        "requireAccess",
        "loadLocal",
        "saveLocal",
        "syncSave",
        "submitScore",
        "flushScores",
        "service",
        "dispose"
      ]
    },
    {
      "name": "PlatformUnavailableError",
      "kind": "class",
      "extends": "Error",
      "code": "sdk-too-old"
    },
    {
      "name": "PAEAN_VERSION",
      "kind": "constant"
    }
  ],
  "optionalExports": [
    {
      "name": "parseSVG",
      "entry": "./vector-svg",
      "kind": "function",
      "requires": "Browser DOMParser; trusted SVG fills only"
    }
  ],
  "notImplemented": [
    "Spine import",
    "DragonBones import",
    "Live2D runtime",
    "2D weighted deformation helpers",
    "inverse kinematics",
    "WebGPU-specific game materials",
    "authoritative multiplayer simulation"
  ],
  "validation": [
    "npm run check --prefix packages/paean-js",
    "npm run test:browser --prefix packages/paean-js",
    "node scripts/paean/check-upstream.mjs"
  ],
  "modules": [
    {
      "entry": "./core",
      "requiresThree": false,
      "exports": [
        {
          "name": "FixedStepLoop",
          "kind": "class",
          "methods": [
            "advance",
            "start",
            "stop",
            "dispose"
          ]
        },
        {
          "name": "Input",
          "kind": "class",
          "methods": [
            "down",
            "justPressed",
            "justReleased",
            "axis",
            "setAction",
            "endFrame",
            "reset",
            "dispose"
          ]
        },
        {
          "name": "AssetStore",
          "kind": "class",
          "methods": [
            "load",
            "has",
            "dispose"
          ]
        },
        {
          "name": "Random",
          "kind": "class",
          "methods": [
            "next",
            "range",
            "int",
            "pick"
          ]
        },
        {
          "name": "PAEAN_VERSION",
          "kind": "constant"
        }
      ]
    },
    {
      "entry": "./2d",
      "requiresThree": false,
      "exports": [
        {
          "name": "Node2D",
          "kind": "class",
          "methods": [
            "add",
            "remove",
            "clear",
            "localMatrix",
            "worldMatrix",
            "localToWorld",
            "worldToLocal",
            "render"
          ]
        },
        {
          "name": "CanvasGame",
          "kind": "class",
          "methods": [
            "resize",
            "screenToWorld",
            "render",
            "start",
            "stop",
            "dispose"
          ]
        }
      ]
    },
    {
      "entry": "./vector",
      "requiresThree": false,
      "exports": [
        {
          "name": "VectorPath",
          "kind": "class",
          "staticMethods": [
            "rectangle",
            "circle",
            "polygon",
            "fromSVGPath"
          ]
        },
        {
          "name": "Rig2D",
          "kind": "class",
          "methods": [
            "addSlot",
            "defineSkin",
            "setSkin",
            "createClip",
            "play",
            "stop",
            "update",
            "dispose"
          ]
        }
      ]
    },
    {
      "entry": "./pixel",
      "requiresThree": false,
      "exports": [
        {
          "name": "SpriteSheet",
          "kind": "class",
          "methods": [
            "frame"
          ],
          "staticMethods": [
            "grid"
          ]
        },
        {
          "name": "Sprite2D",
          "kind": "class",
          "methods": [
            "setFrame",
            "setFlip"
          ]
        },
        {
          "name": "TileLayer",
          "kind": "class",
          "methods": [
            "getTile",
            "setTile",
            "setTiles",
            "pointToTile",
            "isSolid",
            "toJSONDefinition"
          ]
        },
        {
          "name": "PixelGame",
          "kind": "class",
          "methods": [
            "resize",
            "screenToWorld",
            "render",
            "start",
            "stop",
            "dispose"
          ]
        },
        {
          "name": "FrameAnimator",
          "kind": "class",
          "methods": [
            "define",
            "play",
            "stop",
            "update"
          ]
        },
        {
          "name": "GridCollision",
          "kind": "class",
          "methods": [
            "move",
            "overlaps"
          ]
        }
      ]
    },
    {
      "entry": "./platform",
      "requiresThree": false,
      "exports": [
        {
          "name": "PaeanPlatform",
          "kind": "class",
          "methods": [
            "connect",
            "requireAccess",
            "loadLocal",
            "saveLocal",
            "syncSave",
            "submitScore",
            "flushScores",
            "service",
            "dispose"
          ]
        },
        {
          "name": "PlatformUnavailableError",
          "kind": "class"
        }
      ]
    },
    {
      "entry": "./formats",
      "requiresThree": false,
      "exports": [
        {
          "name": "parseAseprite",
          "kind": "function"
        },
        {
          "name": "importTiledLayer",
          "kind": "function"
        }
      ]
    },
    {
      "entry": "./3d/vector",
      "requiresThree": true,
      "exports": [
        {
          "name": "VectorShape",
          "kind": "class",
          "methods": [
            "dispose"
          ],
          "staticMethods": [
            "rectangle",
            "circle",
            "polygon"
          ]
        },
        {
          "name": "Skeleton2D",
          "kind": "class",
          "methods": [
            "addSlot",
            "defineSkin",
            "setSkin",
            "createClip",
            "play",
            "update",
            "dispose"
          ]
        }
      ]
    },
    {
      "entry": "./3d/pixel",
      "requiresThree": true,
      "exports": [
        {
          "name": "Game2D",
          "kind": "class",
          "methods": [
            "start",
            "stop",
            "dispose"
          ]
        },
        {
          "name": "PixelAtlas",
          "kind": "class",
          "methods": [
            "frame",
            "uv",
            "dispose"
          ],
          "staticMethods": [
            "grid"
          ]
        },
        {
          "name": "PixelSprite",
          "kind": "class",
          "methods": [
            "setFrame",
            "setFlip",
            "dispose"
          ]
        },
        {
          "name": "SpriteAnimator",
          "kind": "class",
          "methods": [
            "define",
            "play",
            "stop",
            "update"
          ]
        },
        {
          "name": "PixelViewport",
          "kind": "class",
          "methods": [
            "resize",
            "screenToWorld",
            "snap"
          ]
        },
        {
          "name": "TileMap",
          "kind": "class",
          "methods": [
            "getTile",
            "setTile",
            "setTiles",
            "pointToTile",
            "isSolid",
            "toJSONDefinition",
            "dispose"
          ]
        },
        {
          "name": "GridCollision",
          "kind": "class",
          "methods": [
            "move",
            "overlaps"
          ]
        },
        {
          "name": "importAseprite",
          "kind": "function"
        },
        {
          "name": "importTiledLayer",
          "kind": "function"
        }
      ]
    }
  ],
  "importPolicy": {
    "preferred3D": "./3d",
    "preferredVector": [
      "./2d",
      "./vector"
    ],
    "preferredPixel": [
      "./pixel"
    ],
    "optionalServices": "./platform",
    "assetConversion": "./formats",
    "compatibilityAggregates": [
      ".",
      "./game"
    ],
    "canvasObjects": "Node2D; separate from three.Object3D",
    "threePeers": "Optional for Canvas/core/platform/formats consumers; exact versions required when using 3D or compatibility entries."
  }
}
